 +mixin NavigationContainerMixin {
 +  List<Widget> wrapChildren(BuildContext context, List<NavigationBarItem> children) {
 +    int index = 0;
 +    List<Widget> newChildren = List.of(children);
 +    for (var i = 0; i < children.length; i++) {
