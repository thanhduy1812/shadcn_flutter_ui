 +double _startPadding(EdgeInsets padding, Axis direction) {
 +  if (direction == Axis.vertical) {
 +    return padding.top;
 +  }
 +  return padding.left;
 +}
 +
 +double _endPadding(EdgeInsets padding, Axis direction) {
 +  if (direction == Axis.vertical) {
 +    return padding.bottom;
 +  }
 +  return padding.right;
