+        final light = hslColor.lightness;
+        _onChanging(
+          _effectiveValue
+              .changeToHSLSaturation(sat)
+              .changeToHSLLightness(light),
+        );
+      },
+      onChanged: (hslColor) {
+        final sat = hslColor.saturation;
+        final light = hslColor.lightness;
+        _onChanged(
+          _effectiveValue
+              .changeToHSLSaturation(sat)
+              .changeToHSLLightness(light),
+        );
+      },
+    );
+  }
