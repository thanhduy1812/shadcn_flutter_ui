+      scale: 1,
+      example: Stack(
+        children: [
+          Column(
+            children: [
+              DestructiveButton(
+                leading: const Icon(material.Icons.delete),
+                child: const Text('Delete'),
+                onPressed: () {},
+              ),
+              const Gap(4),
+              const TooltipContainer(
+                child: Text('Click to delete this item'),
+              ),
+            ],
+          ),
+          const Positioned(
+            top: 25,
+            left: 100,
+            child: CustomPaint(
+              painter: CursorPainter(),
+            ),
+          )
+        ],
+      ),
+    );
+  }
+}
