+    testWidgets('accepts custom popover alignments', (tester) async {
+      await tester.pumpWidget(
+        SimpleApp(
+          child: AutoComplete(
+            suggestions: ['Test'],
+            popoverAnchorAlignment: AlignmentDirectional.topStart,
