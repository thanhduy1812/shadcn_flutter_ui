+  TabsTheme copyWith({ValueGetter<EdgeInsetsGeometry?>? containerPadding, ValueGetter<EdgeInsetsGeometry?>? tabPadding, ValueGetter<Color?>? backgroundColor, ValueGetter<BorderRadiusGeometry?>? borderRadius});
