+  /// // combined has: topStart=0, bottomStart=0, topEnd=0.5, bottomEnd=0.5
+  /// ```
+  ButtonGroupData applyToButtonGroupData(ButtonGroupData other);
+  String toString();
+  bool operator ==(Object other);
+  int get hashCode;
+}
