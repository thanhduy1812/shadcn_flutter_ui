+/// Overflow behavior for navigation item labels.
+enum NavigationOverflow {
+  /// Clip text that exceeds bounds
+  clip,
+
+  /// Scroll text horizontally when too long
+  marquee,
+
+  /// Show ellipsis (...) for overflow
+  ellipsis,
+
+  /// No overflow handling
+  none,
+}
