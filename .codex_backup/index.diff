+
+import '../test_helper.dart';
+
+void main() {
+  group('AdaptiveScaler', () {
+    testWidgets('renders child widget', (tester) async {
+      await tester.pumpWidget(
+        SimpleApp(
+          child: AdaptiveScaler(
+            scaling: AdaptiveScaling.mobile,
+            child: const Text('Test Child'),
