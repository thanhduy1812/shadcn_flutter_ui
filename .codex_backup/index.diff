+  const ItemPickerExample1({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return PrimaryButton(
+      onPressed: () {
+        // Show a popover item picker (non-dialog) with a virtual list of 1000 items.
+        showItemPicker<int>(
+          context,
+          title: const Text('Pick an item'),
+          items: ItemBuilder(
+            itemCount: 1000,
+            itemBuilder: (index) {
+              return index;
+            },
