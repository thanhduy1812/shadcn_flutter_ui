+  final int? maxTotalColors;
+  /// Creates a [ColorHistoryGrid].
+  const ColorHistoryGrid({super.key, required this.storage, this.onColorPicked, this.spacing, this.crossAxisCount = 10, this.selectedColor, this.maxTotalColors});
