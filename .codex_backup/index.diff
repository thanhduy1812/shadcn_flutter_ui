+            IconButton.outline(
+              icon: const Icon(Icons.colorize),
+              onPressed: onEyeDropperRequested ??
+                  () async {
+                    final result = await pickColorFromScreen(context);
+                    if (result != null) {
+                      onChanged?.call(ColorDerivative.fromColor(result));
