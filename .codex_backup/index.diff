+      int clickCount = 0;
+      await tester.pumpWidget(
+        SimpleApp(
+          child: ClickDetector(
+            onClick: (details) => clickCount = details.clickCount,
+            child: Text('Child'),
+          ),
+        ),
+      );
+
+      await tester.tap(find.text('Child'));
+      expect(clickCount, equals(1));
